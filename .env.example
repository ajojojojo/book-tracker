# このファイルは「どんな環境変数が必要か」を示す見本です。
# 実際の値は書かず、.env にコピーして各自が埋めてください。
#
#   cp .env.example .env
#
# .env は .gitignore で除外されているためコミットされません。

# Google Books API のキー
# https://console.cloud.google.com/ でプロジェクトを作り、
# Books API を有効化してから発行する
GOOGLE_BOOKS_API_KEY=

# MySQL への接続文字列
# 形式: mysql://ユーザー名:パスワード@ホスト:ポート/データベース名
DATABASE_URL=
