# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# APIキーなどの秘密情報。絶対にコミットしないこと
.env*

# ただし .env.example は「どんな変数が必要か」を示す見本なので追跡する
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma が schema.prisma から自動生成するコード。
# 中身はスキーマから常に再現できるためコミットしない
# (npm install 時に postinstall で自動生成される)
/src/generated
